// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model Schedule {
  id           String     @id @default(cuid())
  name         String
  sessionId    String
  eventTitle   String?
  selectedDays String
  startTime    Int        @default(16)  // 8:00 AM in 30-minute slots (8*2=16)
  endTime      Int        @default(36)  // 6:00 PM in 30-minute slots (18*2=36)
  createdAt    DateTime   @default(now())
  busySlots    BusySlot[]

  @@map("schedules")
}

model BusySlot {
  id         String   @id @default(cuid())
  scheduleId String
  day        String
  hour       Int
  minute     Int      @default(0)
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("busy_slots")
}
